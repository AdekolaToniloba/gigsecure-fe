    "/api/v1/marketplace/products": {
      "get": {
        "tags": ["Marketplace"],
        "summary": "List Products",
        "operationId": "list_products_api_v1_marketplace_products_get",
        "parameters": [
          { "name": "category", "in": "query", "required": false, "schema": { "anyOf": [{ "type": "array", "items": { "type": "string" } }, { "type": "null" }] } },
          { "name": "provider_slug", "in": "query", "required": false, "schema": { "anyOf": [{ "type": "array", "items": { "type": "string" } }, { "type": "null" }] } },
          { "name": "risk_level", "in": "query", "required": false, "schema": { "anyOf": [{ "type": "array", "items": { "type": "string" } }, { "type": "null" }] } },
          { "name": "q", "in": "query", "required": false, "schema": { "anyOf": [{ "type": "string", "maxLength": 128 }, { "type": "null" }] } },
          { "name": "min_premium", "in": "query", "required": false, "schema": { "anyOf": [{ "type": "number" }, { "type": "string" }, { "type": "null" }] } },
          { "name": "max_premium", "in": "query", "required": false, "schema": { "anyOf": [{ "type": "number" }, { "type": "string" }, { "type": "null" }] } },
          { "name": "limit", "in": "query", "required": false, "schema": { "type": "integer", "minimum": 1, "maximum": 100, "default": 20 } },
          { "name": "offset", "in": "query", "required": false, "schema": { "type": "integer", "minimum": 0, "default": 0 } }
        ],
        "responses": { "200": { "description": "Successful Response", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ProductListResponse" } } } } }
      }
    },
    "/api/v1/marketplace/recommendations": { "get": { "tags": ["Marketplace"], "summary": "Get Recommendations", "operationId": "get_recommendations_api_v1_marketplace_recommendations_get", "security": [{ "HTTPBearer": [] }], "parameters": [{ "name": "per_category", "in": "query", "required": false, "schema": { "type": "integer", "minimum": 1, "maximum": 10, "default": 3 } }], "responses": { "200": { "description": "Successful Response", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/RecommendedProductsResponse" } } } } } } },
    "/api/v1/marketplace/products/{product_id}": { "get": { "tags": ["Marketplace"], "summary": "Get Product", "operationId": "get_product_api_v1_marketplace_products__product_id__get", "parameters": [{ "name": "product_id", "in": "path", "required": true, "schema": { "type": "string" } }], "responses": { "200": { "description": "Successful Response", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ProductOut" } } } } } } },
    "/api/v1/policies": {
      "get": { "tags": ["Policies"], "summary": "List Policies", "operationId": "list_policies_api_v1_policies_get", "security": [{ "HTTPBearer": [] }], "parameters": [{ "name": "status_filter", "in": "query", "required": false, "schema": { "anyOf": [{ "type": "string" }, { "type": "null" }] } }], "responses": { "200": { "description": "Successful Response", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/PolicyListResponse" } } } } } },
      "post": { "tags": ["Policies"], "summary": "Create Policy", "operationId": "create_policy_api_v1_policies_post", "security": [{ "HTTPBearer": [] }], "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/PolicyCreate" } } } }, "responses": { "201": { "description": "Successful Response", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/PolicyOut" } } } } } }
    },
    "/api/v1/policies/summary": { "get": { "tags": ["Policies"], "summary": "Policy Summary", "operationId": "policy_summary_api_v1_policies_summary_get", "security": [{ "HTTPBearer": [] }], "responses": { "200": { "description": "Successful Response", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/PolicySummary" } } } } } } },
    "/api/v1/policies/{policy_id}": { "get": { "tags": ["Policies"], "summary": "Get Policy", "operationId": "get_policy_api_v1_policies__policy_id__get", "security": [{ "HTTPBearer": [] }], "parameters": [{ "name": "policy_id", "in": "path", "required": true, "schema": { "type": "string" } }], "responses": { "200": { "description": "Successful Response", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/PolicyOut" } } } } } } },
    "/api/v1/policies/{policy_id}/pay": { "post": { "tags": ["Policies"], "summary": "Mock Pay", "operationId": "mock_pay_api_v1_policies__policy_id__pay_post", "security": [{ "HTTPBearer": [] }], "parameters": [{ "name": "policy_id", "in": "path", "required": true, "schema": { "type": "string" } }], "responses": { "200": { "description": "Successful Response", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/PolicyOut" } } } } } } },
    "/api/v1/policies/{policy_id}/report": { "get": { "tags": ["Policies"], "summary": "Policy Report", "operationId": "policy_report_api_v1_policies__policy_id__report_get", "security": [{ "HTTPBearer": [] }], "parameters": [{ "name": "policy_id", "in": "path", "required": true, "schema": { "type": "string" } }], "responses": { "200": { "description": "Successful Response" } } } },
    "/api/v1/dashboard/overview": { "get": { "tags": ["Dashboard"], "summary": "Get Dashboard Overview", "operationId": "get_dashboard_overview_api_v1_dashboard_overview_get", "security": [{ "HTTPBearer": [] }], "responses": { "200": { "description": "Successful Response", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/DashboardOverviewResponse" } } } } } } },
    "/api/v1/claims/": {
      "get": { "tags": ["Claims"], "summary": "List Claims", "operationId": "list_claims", "responses": { "200": { "description": "Successful Response" } } },
      "post": { "tags": ["Claims"], "summary": "Submit Claim", "operationId": "submit_claim", "responses": { "200": { "description": "Successful Response" } } }
    },
    "/api/v1/claims/{claim_id}": { "get": { "tags": ["Claims"], "summary": "Get Claim", "operationId": "get_claim", "parameters": [{ "name": "claim_id", "in": "path", "required": true, "schema": { "type": "string" } }], "responses": { "200": { "description": "Successful Response" } } } },
    "/api/v1/payments/initialize": { "post": { "tags": ["Payments"], "summary": "Initialize Payment", "operationId": "initialize_payment", "responses": { "200": { "description": "Successful Response" } } } },
    "/api/v1/payments/{payment_id}": { "get": { "tags": ["Payments"], "summary": "Get Payment", "operationId": "get_payment", "parameters": [{ "name": "payment_id", "in": "path", "required": true, "schema": { "type": "string" } }], "responses": { "200": { "description": "Successful Response" } } } },
    "/api/v1/payments/history": { "get": { "tags": ["Payments"], "summary": "Get Payment History", "operationId": "get_payment_history", "responses": { "200": { "description": "Successful Response" } } } }
  },
  "components": {
    "schemas": {
      "ActivateAccountRequest": { "properties": { "token": { "type": "string", "title": "Token" }, "password": { "type": "string", "title": "Password" } }, "type": "object", "required": ["token", "password"], "title": "ActivateAccountRequest" },
      "ChangePasswordRequest": { "properties": { "old_password": { "type": "string" }, "new_password": { "type": "string" } }, "type": "object", "required": ["old_password", "new_password"], "title": "ChangePasswordRequest" },
      "ForgotPasswordRequest": { "properties": { "email": { "type": "string", "format": "email" } }, "type": "object", "required": ["email"], "title": "ForgotPasswordRequest" },
      "HTTPValidationError": { "properties": { "detail": { "items": { "$ref": "#/components/schemas/ValidationError" }, "type": "array" } }, "type": "object", "title": "HTTPValidationError" },
      "KYCStatusResponse": {
        "properties": {
          "status": { "anyOf": [{ "type": "string" }, { "type": "null" }], "title": "Status" },
          "document_type": { "anyOf": [{ "type": "string" }, { "type": "null" }], "title": "Document Type" },
          "verified_at": { "anyOf": [{ "type": "string", "format": "date-time" }, { "type": "null" }], "title": "Verified At" },
          "rejection_reason": { "anyOf": [{ "type": "string" }, { "type": "null" }], "title": "Rejection Reason" }
        },
        "type": "object",
        "required": ["status", "document_type", "verified_at", "rejection_reason"],
        "title": "KYCStatusResponse"
      },
      "KYCVerifyRequest": {
        "properties": {
          "document_type": { "type": "string", "const": "NIN", "title": "Document Type" },
          "document_number": { "type": "string", "title": "Document Number" },
          "first_name": { "type": "string", "title": "First Name" },
          "last_name": { "type": "string", "title": "Last Name" },
          "date_of_birth": { "type": "string", "title": "Date Of Birth" }
        },
        "type": "object",
        "required": ["document_type", "document_number", "first_name", "last_name", "date_of_birth"],
        "title": "KYCVerifyRequest"
      },
      "KYCVerifyResponse": {
        "properties": {
          "status": { "type": "string", "title": "Status" },
          "message": { "type": "string", "title": "Message" },
          "smile_job_id": { "anyOf": [{ "type": "string" }, { "type": "null" }], "title": "Smile Job Id" }
        },
        "type": "object",
        "required": ["status", "message"],
        "title": "KYCVerifyResponse"
      },
      "LoginRequest": { "properties": { "email": { "type": "string" }, "password": { "type": "string" } }, "type": "object", "required": ["email", "password"], "title": "LoginRequest" },
      "RefreshTokenRequest": { "properties": { "refresh_token": { "type": "string" } }, "type": "object", "required": ["refresh_token"], "title": "RefreshTokenRequest" },
      "RegisterRequest": { "properties": { "email": { "type": "string", "format": "email" }, "password": { "type": "string" }, "first_name": { "type": "string" }, "last_name": { "anyOf": [{ "type": "string" }, { "type": "null" }] } }, "type": "object", "required": ["email", "password", "first_name"], "title": "RegisterRequest" },
      "ResendActivationRequest": { "properties": { "email": { "type": "string", "format": "email" } }, "type": "object", "required": ["email"], "title": "ResendActivationRequest" },
      "ResetPasswordRequest": { "properties": { "token": { "type": "string" }, "new_password": { "type": "string" } }, "type": "object", "required": ["token", "new_password"], "title": "ResetPasswordRequest" },
      "SmileIDCallbackPayload": {
        "properties": {
          "signature": { "type": "string", "title": "Signature" },
          "timestamp": { "type": "string", "title": "Timestamp" },
          "SmileJobID": { "type": "string", "title": "Smilejobid" },
          "ResultCode": { "type": "string", "title": "Resultcode" },
          "ResultText": { "type": "string", "title": "Resulttext" },
          "Actions": { "additionalProperties": true, "type": "object", "title": "Actions" },
          "PartnerParams": { "additionalProperties": true, "type": "object", "title": "Partnerparams" }
        },
        "type": "object",
        "required": ["signature", "timestamp", "SmileJobID", "ResultCode", "ResultText", "Actions", "PartnerParams"],
        "title": "SmileIDCallbackPayload"
      },
      "DashboardOverviewResponse": { "properties": { "premiums_bought": { "type": "integer", "default": 0 }, "monthly_income_band": { "anyOf": [{ "type": "string" }, { "type": "null" }] }, "safety_buffer": { "anyOf": [{ "type": "string" }, { "type": "null" }] }, "recommended_plans_count": { "type": "integer", "default": 0 }, "income_stability": { "anyOf": [{ "$ref": "#/components/schemas/IncomeStabilityPattern" }, { "type": "null" }] }, "has_assessment": { "type": "boolean", "default": false } }, "type": "object", "title": "DashboardOverviewResponse" },
      "IncomeStabilityPattern": { "properties": { "score": { "type": "integer" }, "classification": { "type": "string" }, "graph_points": { "type": "array", "items": { "type": "number" } } }, "type": "object", "required": ["score", "classification", "graph_points"], "title": "IncomeStabilityPattern" },
      "PolicyCreate": { "properties": { "product_id": { "type": "string", "minLength": 1 } }, "type": "object", "required": ["product_id"], "title": "PolicyCreate" },
      "PolicyListResponse": { "properties": { "items": { "type": "array", "items": { "$ref": "#/components/schemas/PolicyOut" } } }, "type": "object", "required": ["items"], "title": "PolicyListResponse" },
      "PolicyOut": { "properties": { "id": { "type": "string" }, "status": { "type": "string" }, "display_status": { "type": "string" }, "coverage_amount": { "type": "string" }, "premium_amount": { "type": "string" }, "premium_currency": { "type": "string" }, "renewal_frequency": { "type": "string" }, "start_date": { "anyOf": [{ "type": "string", "format": "date" }, { "type": "null" }] }, "end_date": { "anyOf": [{ "type": "string", "format": "date" }, { "type": "null" }] }, "purchased_at": { "anyOf": [{ "type": "string", "format": "date-time" }, { "type": "null" }] }, "external_policy_id": { "anyOf": [{ "type": "string" }, { "type": "null" }] }, "created_at": { "type": "string", "format": "date-time" }, "product": { "$ref": "#/components/schemas/PolicyProductSummary" } }, "type": "object", "required": ["id", "status", "display_status", "coverage_amount", "premium_amount", "premium_currency", "renewal_frequency", "created_at", "product"], "title": "PolicyOut" },
      "PolicyProductSummary": { "properties": { "id": { "type": "string" }, "name": { "type": "string" }, "category": { "type": "string" }, "provider_name": { "type": "string" }, "provider_slug": { "type": "string" } }, "type": "object", "required": ["id", "name", "category", "provider_name", "provider_slug"], "title": "PolicyProductSummary" },
